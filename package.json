{
  "name": "tajemnicza-okolica",
  "version": "0.1.0",
  "private": true,
  "description": "Tajemnicza Okolica — terenowa gra quizowa: interaktywna mapa, stacje w realnej okolicy gracza, pytania generowane przez model AI i wklejane z powrotem do aplikacji",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "build": "node tools/synchronizuj-szablon.mjs",
    "check": "node tools/synchronizuj-szablon.mjs --check",
    "brama": "node --test && node tools/synchronizuj-szablon.mjs --check && node tools/audyt-kontrastu.mjs",
    "fixture": "node tools/generuj-fixture-overpass.mjs",
    "ikony": "node tools/generuj-ikony.mjs",
    "serwer": "node tools/serwer.mjs .",
    "audyt": "node tools/audyt-kontrastu.mjs",
    "budzet": "node tools/budzet-lektury.mjs",
    "zasieg-mostu": "node tools/zasieg-mostu.mjs"
  },
  "engines": {
    "node": ">=20"
  },
